{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NavPro: Build Release",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "NavPro.sln", "-c", "Release", "--nologo"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "NavPro: Run tests",
      "type": "process",
      "command": "${workspaceFolder}/Tests/bin/Release/net48/NavPro.Tests.exe",
      "dependsOn": "NavPro: Build Release",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "NavPro: Build shareable package",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/Tools/Build-Package.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile"
    }
  ]
}
